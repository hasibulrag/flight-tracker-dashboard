      "id": "7201d0ec-0a6c-4b0c-be1e-f9d4b99f2c9e",
      "name": "Check Flight Status (Aviationstack)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -512,
        48
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Extract current status from Aviationstack response and pair with the tracked flight record\nconst raw = $input.first().json;\nconst flightData = raw && raw.data && raw.data[0] ? raw.data[0] : null;\nconst tracked = $('Loop Over Flights').item.json;\n\nif (raw && raw.error) {\n  // The Aviationstack call failed even after retries - skip this flight for\n  // this cycle, it will just be picked up again next run.\n  return [{ json: { skip: true, flight_number: tracked.flight_number, api_error: true } }];\n}\n\nif (!flightData) {\n  return [{ json: { skip: true, flight_number: tracked.flight_number } }];\n}\n\nconst currentStatus = flightData.flight_status || 'unknown';\nconst gate = flightData.departure && flightData.departure.gate ? flightData.departure.gate : null;\nconst delayMinutes = flightData.departure && flightData.departure.delay ? flightData.departure.delay : 0;\nconst terminalStatuses = ['landed', 'cancelled'];\n\nreturn [{\n  json: {\n    flight_id: tracked.id,\n    flight_number: tracked.flight_number,\n    customer_email: tracked.customer_email,\n    customer_whatsapp: tracked.customer_whatsapp,\n    previous_status: tracked.last_status || 'unknown',\n    current_status: currentStatus,\n    gate: gate,\n    delay_minutes: delayMinutes,\n    status_changed: currentStatus !== (tracked.last_status || 'unknown'),\n    still_active: !terminalStatuses.includes(currentStatus)\n  }\n}];"
      },
      "id": "b116980f-a1fd-4e82-8ae2-58ba5eec35ae",
      "name": "Compare Status (Code)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
        48
      ]
    },
    {
      "parameters": {
        "conditions": {
