        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 480px; margin: 0 auto; background-color: #ffffff; border: 1px solid #e5e7eb; border-radius: 10px; overflow: hidden;\">\n  <div style=\"background-color: #0f172a; padding: 22px; text-align: center;\">\n    <span style=\"color: #f5a623; font-size: 18px; font-weight: bold; letter-spacing: 2px;\">✈ FLIGHT DECK</span>\n    <div style=\"color: #94a3b8; font-size: 10px; letter-spacing: 1px; margin-top: 4px;\">DIPTYAI OPERATIONS</div>\n  </div>\n  <div style=\"padding: 24px;\">\n    <div style=\"text-align: center; margin-bottom: 20px;\">\n      <div style=\"font-size: 22px; font-weight: bold; color: #0f172a;\">{{ $json.flight_number }}</div>\n      <div style=\"display:inline-block;margin-top:10px;padding:6px 18px;border-radius:20px;font-weight:bold;font-size:12px;letter-spacing:0.5px;background-color:{{ $json.current_status === 'cancelled' ? '#fee2e2' : $json.current_status === 'delayed' ? '#fef3c7' : '#d1fae5' }};color:{{ $json.current_status === 'cancelled' ? '#dc2626' : $json.current_status === 'delayed' ? '#d97706' : '#16a766' }};\">{{ $json.current_status.toUpperCase() }}</div>\n    </div>\n    <table style=\"width: 100%; border-collapse: collapse; font-size: 14px; color: #334155;\">\n      <tr>\n        <td style=\"padding: 10px 0; color: #94a3b8;\">Previous Status</td>\n        <td style=\"padding: 10px 0; text-align: right; font-weight: 600;\">{{ $json.previous_status }}</td>\n      </tr>\n      <tr style=\"border-top: 1px solid #f1f5f9;\">\n        <td style=\"padding: 10px 0; color: #94a3b8;\">Gate</td>\n        <td style=\"padding: 10px 0; text-align: right; font-weight: 600;\">{{ $json.gate }}</td>\n      </tr>\n      <tr style=\"border-top: 1px solid #f1f5f9;\">\n        <td style=\"padding: 10px 0; color: #94a3b8;\">Delay</td>\n        <td style=\"padding: 10px 0; text-align: right; font-weight: 600;\">{{ $json.delay_minutes }} min</td>\n      </tr>\n    </table>\n  </div>\n  <div style=\"background-color: #f8fafc; padding: 14px 24px; text-align: center; font-size: 11px; color: #94a3b8;\">\n    Automated update from DiptyAI Flight Tracker\n  </div>\n</div>",
